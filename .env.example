# Pooled PostgreSQL URL for application requests (Neon/Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct PostgreSQL URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Email allowed to sign in to the internal admin panel after seeding.
ADMIN_EMAIL="owner@example.com"
# Required in production for the daily Vercel Cron cleanup job
CRON_SECRET="REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET"
# Optional email delivery for production password resets
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
RESEND_FROM_EMAIL="security@YOUR_VERIFIED_DOMAIN"
# Required when manually seeding demo data and the internal admin account
SEED_OWNER_PASSWORD="REPLACE_WITH_A_STRONG_DEMO_PASSWORD"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_DIFFERENT_STRONG_DEMO_PASSWORD"
